{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://une.example/schemas/common-defs.schema.json",
  "title": "Common Definitions",
  "$defs": {
    "dataStatus": {
      "type": "string",
      "enum": [
        "actual",
        "actual_backed",
        "open_api",
        "t3q_supplied",
        "derived",
        "scenario",
        "scenario_input",
        "mock",
        "synthetic_demo",
        "provisional",
        "not_available"
      ]
    },
    "hazardCode": {
      "type": "string",
      "minLength": 1
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "geojsonGeometry": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "coordinates": {}
      },
      "additionalProperties": true
    },
    "evidenceRef": {
      "type": "object",
      "required": [
        "evidence_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
