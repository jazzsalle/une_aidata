# Frontend / Vercel
VITE_API_BASE_URL=/api/v1
VITE_USE_SEED_DIRECTLY=false
VITE_VWORLD_MAP_KEY=
# VWorld 키에 등록된 서비스 URL. 비워두면 window.location.origin 을 쓴다.
# VWorld 는 DOMAIN 을 등록값과 대조하므로, localhost 개발 시에는 등록 도메인을 적어야
# 데이터·WMS 계열 호출이 INCORRECT_KEY 로 거절되지 않는다. (WMTS 배경지도는 영향 없음)
VITE_VWORLD_SERVICE_DOMAIN=

# Runtime mode: live | hybrid | scenario
POC_DATA_MODE=hybrid

# UNE RAG - 실제 Swagger에 맞춰 경로만 변경하면 Adapter 코드는 유지됩니다.
UNE_RAG_BASE_URL=http://221.147.100.161:8000
UNE_RAG_AUTH_MODE=login
UNE_RAG_LOGIN_PATH=/auth/login
UNE_RAG_SEARCH_PATH=/search
UNE_RAG_OPENAPI_PATH=/openapi.json
UNE_RAG_RESPONSE_ARRAY_PATH=
UNE_RAG_QUERY_FIELD=query
UNE_RAG_TOPK_FIELD=top_k
UNE_RAG_FILTERS_FIELD=filters
UNE_RAG_DATASET_FIELD=dataset
UNE_RAG_USERNAME=
UNE_RAG_PASSWORD=
UNE_RAG_API_KEY=
UNE_RAG_TIMEOUT_MS=15000
UNE_RAG_DEFAULT_TOP_K=5
UNE_RAG_DEFAULT_DATASET=

# Public APIs
# 기상청 단기예보 조회서비스(초단기실황)
DATA_GO_KR_SERVICE_KEY=
KMA_ULTRA_SRT_NCST_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst
KMA_REQUEST_LAG_MINUTES=45

# 한강홍수통제소 표준수문DB 등 수문 API는 관측소 코드 확정 후 활성화
HRFCO_API_BASE_URL=
HRFCO_WATERLEVEL_PATH=
HRFCO_SERVICE_KEY=
HRFCO_STATION_MAP_JSON=
HRFCO_SERVICE_KEY_PARAM=serviceKey
HRFCO_STATION_PARAM=stationCode
HRFCO_TIMEOUT_MS=12000
HRFCO_WATERLEVEL_UNIT=m
HRFCO_FLOW_UNIT=㎥/s

SAFETY_DATA_API_KEY=

# VWorld - 브라우저 지도 키와 동일 키를 서버 진단에도 지정 가능
VWORLD_SERVER_API_KEY=

# Optional behavior
FUNCTION_REGION=icn1
LOG_LEVEL=info

# T3Q data meta/ontology integration (pending until official external contract)
T3Q_MCP_AUTH=

# T3Q provisional search paths - 실제 협의 규격 수신 후 입력
T3Q_AUTH_SCHEME=Bearer
T3Q_API_KEY_HEADER=authorization
T3Q_EVENT_SEARCH_PATH=
T3Q_PASSAGE_SEARCH_PATH=
T3Q_RESPONSE_ARRAY_PATH=
T3Q_TIMEOUT_MS=12000
# T3Q integration policy (current phase)
# No external T3Q technical integration is attempted. Keep domain contracts and use Mock/Seed only.
T3Q_RUNTIME_MODE=mock_only
# Future-only placeholders. Leave empty until T3Q publishes an approved interface.
T3Q_API_BASE_URL=
T3Q_API_KEY=
T3Q_MCP_URL=

# Provider-neutral source selection (v1.3)
EVENT_PROVIDER=mock
RISK_PROVIDER=mock
OBSERVATION_PROVIDER=mock
SPATIAL_PROVIDER=mock
